ELEVEN_API_KEY=your_elevenlabs_api_key_here

# Comma-separated list of name:voice_id pairs.
# At startup, VoiceShift will list these and let you pick.
# Names are for your own reference; voice IDs come from your ElevenLabs voice library.
ELEVEN_VOICES=Villain:zYcjlYFOd3taleS0gkk3,Old Man:NOpBlnGInO9m6vDvFkFC,British Guy:7S3KNdLDL7aRgBVRQb1z

# Optional: fallback if ELEVEN_VOICES is empty.
ELEVEN_VOICE_ID=

# eleven_flash_v2_5 is optimized for sub-300ms first-chunk latency (best for
# real-time voice). Use eleven_turbo_v2_5 or eleven_multilingual_v2 for higher
# fidelity at the cost of latency.
ELEVEN_MODEL_ID=eleven_flash_v2_5

USE_ELEVENLABS=true

# Use the websocket realtime API (lowest latency, ~150-300ms TTFA).
# Set false to fall back to the HTTP streaming endpoint.
USE_REALTIME=true

# Used only when USE_ELEVENLABS=false.
EDGE_VOICE=en-US-GuyNeural

WHISPER_MODEL=tiny.en

# Whisper beam size. 1 = greedy (fastest), 5 = better first-word accuracy
# (~1.5-2x slower transcription). Bump higher if you still see early-word
# errors; drop to 1 if latency matters more.
WHISPER_BEAM_SIZE=5

# Audio (seconds) prepended to each detected utterance before Whisper sees
# it. Larger = less chance of clipping a soft first phoneme like "Oh-",
# at the cost of a tiny bit more audio to transcribe. 0.3-0.7 is sensible.
PRE_ROLL_SECONDS=0.5

# Path to a custom vocabulary file. One word/phrase per line to bias Whisper,
# or "wrong -> right" lines to force literal substitutions on the transcript.
# Lines starting with # are comments.
VOCAB_FILE=vocab.txt

# Restrict the output device picker to the MME host API only. Useful if
# WASAPI/DirectSound entries don't stream cleanly on your system.
MME_ONLY=false

# Carry your inflections through to the synthesized voice by detecting
# prosodic features (questions, pauses, emphasis, speaking rate) from your
# audio and injecting them as punctuation/casing in the text sent to TTS.
# Adds ~10-30ms per utterance. Approximation, not full prosody transfer
CARRY_INFLECTION=false

# Print per-word pitch/energy/duration when CARRY_INFLECTION=true. Useful
# when an utterance gets misclassified — shows what the analyzer saw.
PROSODY_DEBUG=false

# Trailing silence (ms) required before VoiceShift considers an utterance
# complete. Lower = snappier endpointing but more likely to cut off pauses.
SILENCE_END_MS=350
